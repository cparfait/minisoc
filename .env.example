# Copier en .env avec : python scripts/init_env.py   (génère tous les secrets)
# Ne jamais versionner le fichier .env.

# --- Secrets (générés automatiquement) ---
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINISOC_INGEST_TOKEN=
MINISOC_MASTER_KEY=
MINISOC_BITDEFENDER_TOKEN=

# --- Réseau ---
# Nom DNS de l'outil sur le réseau interne (doit correspondre au certificat)
MINISOC_HOSTNAME=localhost
MINISOC_PUBLIC_URL=https://localhost
# Adresse d'écoute de l'interface web (0.0.0.0 = toutes ; mettre l'IP du VLAN d'administration)
WEB_BIND=0.0.0.0
# Adresse d'écoute syslog (mettre l'IP qui reçoit les journaux des équipements)
SYSLOG_BIND=0.0.0.0

# --- Bitdefender GravityZone (push) ---
# Plages d'IP autorisées à pousser des événements, au format JSON. Vide = pas de filtrage.
MINISOC_BITDEFENDER_ALLOWED_IPS=[]
MINISOC_BITDEFENDER_CONSOLE_URL=https://cloud.gravityzone.bitdefender.com

# --- HarfangLab (jeton d'API en lecture seule) ---
MINISOC_HARFANGLAB_URL=
MINISOC_HARFANGLAB_TOKEN=
MINISOC_HARFANGLAB_VERIFY_TLS=true

# --- Notifications ---
MINISOC_SMTP_HOST=
MINISOC_SMTP_PORT=587
MINISOC_SMTP_STARTTLS=true
MINISOC_SMTP_USER=
MINISOC_SMTP_PASSWORD=
MINISOC_SMTP_FROM=
# Liste JSON, ex. ["admin.reseau@exemple.fr"]
MINISOC_SMTP_TO=[]
# Webhook d'un flux « Workflows » Teams (Publier dans un canal lorsqu'une requête webhook est reçue)
MINISOC_TEAMS_WEBHOOK_URL=
# Notification mobile ntfy (application ntfy sur le téléphone, abonnée au même sujet)
MINISOC_NTFY_URL=
MINISOC_NTFY_TOPIC=
MINISOC_NTFY_TOKEN=

# --- GeoIP (facultatif) : bases GeoLite2 de MaxMind, mises à jour automatiquement ---
# Compte gratuit sur maxmind.com > Manage license keys > Generate new license key.
# Activer en décommentant COMPOSE_PROFILES, puis : docker compose up -d geoipupdate
#COMPOSE_PROFILES=geoip
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
