{
	admin off
	# Un navigateur n'annonce aucun nom (SNI) quand on l'appelle par adresse IP : certificat de l'IP par défaut
	default_sni {$MINISOC_IP:127.0.0.1}
}

# Accès par l'adresse IP (https://<IP>) : renvoi vers le nom, seul couvert par le certificat de l'interface
https://{$MINISOC_IP:127.0.0.1} {
	tls internal
	redir https://{$MINISOC_HOSTNAME}{uri} 308
}

{$MINISOC_HOSTNAME} {
	# Par défaut, certificat émis par l'autorité locale de Caddy (réseau interne). Certificat de votre PKI ou
	# wildcard : MINISOC_TLS=/certs/minisoc.crt /certs/minisoc.key dans .env, fichiers dans MINISOC_TLS_DIR
	# (sudo minisoc-setup le fait sur la VM).
	tls {$MINISOC_TLS:internal}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	# La documentation interactive de l'API n'est pas exposée
	handle /api/docs* {
		respond 404
	}
	handle /api/openapi.json {
		respond 404
	}

	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
