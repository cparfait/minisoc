#!/bin/sh
# Accueil Mini-SOC à chaque connexion (console et SSH) : bandeau, état, et seulement ce qui reste à faire.
# Calculé à chaque connexion (lancé par pam_motd, en root) : rien de figé, rien de périmé.
G='\033[1;32m' D='\033[0;32m' R='\033[1;31m' Y='\033[1;33m' W='\033[1;37m' N='\033[0m'
printf "$G"; cat /usr/local/share/minisoc/banner.txt; printf "$N\n"

host=$(hostname -f 2>/dev/null || hostname)
ip=$(ip -4 -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')

if [ ! -e /var/lib/minisoc-firstboot.done ]; then
  printf "  ${W}%s${N} ${D}·${N} ${W}%s${N}\n\n" "$host" "$ip"
  if [ "$(systemctl is-active minisoc-firstboot.service 2>/dev/null)" = activating ]; then
    printf "  ${Y}Installation en cours.${N} Suivre : ${G}sudo journalctl -fu minisoc-firstboot${N}\n\n"
  else
    printf "  ${R}Installation inachevée.${N} Reprendre : ${G}sudo /usr/local/sbin/minisoc-firstboot${N}\n"
    printf "  ${D}Détails : /var/log/minisoc-firstboot.log${N}\n\n"
  fi
  exit 0
fi

running=$(docker ps -q --filter label=com.docker.compose.project=minisoc 2>/dev/null | wc -l)
if [ "$running" -gt 0 ]; then app="${G}Mini-SOC : $running conteneurs en marche${N}"
else app="${R}Mini-SOC arrêté${N} (état : ${G}sudo minisoc-setup${N}, T)"; fi
printf "  ${W}%s${N} ${D}·${N} ${W}%s${N} ${D}·${N} $app\n" "$host" "$ip"
[ ! -s /etc/minisoc/version ] || printf "  ${D}Version %s · mise à jour : sudo minisoc-update <paquet>${N}\n" "$(cat /etc/minisoc/version)"

todo=""
add() { todo="$todo  ${Y}!${N} ${W}$1${N}\n      ${G}$2${N}\n"; }
grep -qs 'MODE INITIAL' /etc/minisoc/firewall.conf \
  && add "Pare-feu en mode initial (toutes les plages privées)" "sudo minisoc-setup : E (entrants) puis A (appliquer)"
[ -s /home/adminsoc/.ssh/authorized_keys ] \
  || add "SSH par mot de passe (aucune clé)" "sudo minisoc-setup : K (clés SSH) puis A (appliquer)"
[ -e /etc/minisoc/coffre-fort.fait ] \
  || add "Secrets à copier dans le coffre-fort de la DSI" "sudo minisoc-setup : F (fichiers et secrets)"
# Ancienne base PostgreSQL gardée après une montée de version majeure (minisoc-update) : à supprimer après vérification
current=$(docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{end}}{{end}}' minisoc-postgres-1 2>/dev/null)
old=""
for v in $(docker volume ls -q --filter name=minisoc_pgdata 2>/dev/null); do [ "$v" = "$current" ] || old="$old $v"; done
[ -z "$old" ] || add "Ancienne base PostgreSQL conservée après la mise à jour :$old" \
  "une fois l'application vérifiée : sudo docker volume rm$old"
if [ -n "$todo" ]; then printf "\n  ${Y}À faire :${N}\n$todo"; fi
printf "\n  ${D}Paramétrage :${N} ${G}sudo minisoc-setup${N}\n\n"
