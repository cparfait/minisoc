[Unit]
Description=Mini-SOC : analyse Trivy des images Docker et des paquets de la VM
Documentation=file:///opt/minisoc/deploy/trivy/minisoc-trivy.sh
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/minisoc-trivy
# Analyse en tâche de fond : la réception des journaux reste prioritaire
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
